pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code from GitHub...'
            }
        }

        stage('Compile') {
            steps {
                echo 'Compiling Hello.java...'
                bat 'javac Hello.java'
            }
        }

        stage('Run') {
            steps {
                echo 'Running Hello...'
                bat 'java Hello'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}